<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\build\Windows.props" />
  <PropertyGroup>
    <AssemblyName>Survivalcraft.CompatNet</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <ProjectReference Include="..\Survivalcraft.Windows\Survivalcraft.Windows.csproj">
      <Private>false</Private>
      <AdditionalProperties>SkipNetworkModPackage=true;SkipCompatibilityModPackage=true;SkipCompatibilityMods=true;SkipContentZip=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\Survivalcraft.Multiplayer\Survivalcraft.Multiplayer.csproj">
      <Private>false</Private>
      <AdditionalProperties>GenerateModPackage=false;SkipContentZip=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup>
      <ModTempDir>$(IntermediateOutputPath)ModTemp\</ModTempDir>
      <ModOutputPath Condition="'$(ModOutputPath)' == ''">..\Survivalcraft.Test\bin\$(Configuration)\net10.0-windows\$(WindowsRuntimeIdentifier)\Mods\</ModOutputPath>
    </PropertyGroup>
    <RemoveDir Directories="$(ModTempDir)" />
    <MakeDir Directories="$(ModTempDir)" />
    <MakeDir Directories="$(ModOutputPath)" />
    <Delete Files="$(ModOutputPath)Survivalcraft.GunModCompat.scmod;$(ModOutputPath)CompatNet.scmod" />
    <ItemGroup>
      <ModDependencyFiles Include="$(TargetDir)Mono.Cecil.dll" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModTempDir)" />
    <Copy SourceFiles="@(ModDependencyFiles)" DestinationFolder="$(ModTempDir)" />
    <Copy SourceFiles="modinfo.json" DestinationFolder="$(ModTempDir)" />
    <ZipDirectory SourceDirectory="$(ModTempDir)" DestinationFile="$(ModOutputPath)Survivalcraft.CompatNet.scmod" Overwrite="true" />
  </Target>
</Project>
