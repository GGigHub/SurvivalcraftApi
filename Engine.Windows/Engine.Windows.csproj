<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Engine\Engine.props" />
    <Import Project="..\build\Windows.props" />
    <PropertyGroup>
        <DefineConstants Condition="'$(UseAngle)' == 'true'">$(DefineConstants);ANGLE</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="..\Engine\Resources\icon.png" Link="Resources\icon.png" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="NativeFileDialogCore" Version="1.0.3" />
        <PackageReference Include="Silk.NET.OpenXR" Version="2.23.0" />
        <PackageReference Include="Silk.NET.OpenXR.Extensions.KHR" Version="2.23.0" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="VR\*.cs" Link="VR\%(Filename).cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseAngle)' == 'true'">
        <Compile Include="..\Engine\Engine.Graphics\EGL.cs" Link="Engine.Graphics\EGL.cs" />
        <!-- 原生 DLL 时间戳旧于输出目录（ANGLE 构建产物），必须 Always 强制覆盖。
             按 $(WindowsRuntimeIdentifier) 自动选择 win-x64 / win-arm64 对应架构的库，
             Link 展平到输出根目录；win-x64 未提供 d3dcompiler_47.dll 时由系统承担。
             ANGLE 版本：win-arm64 来自 mmozeiko/build-angle，win-x64 为历史版本。 -->
        <None Include="runtimes\$(WindowsRuntimeIdentifier)\native\*.dll"
              Link="%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Compatible Patch Note 兼容补丁使用说明.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
