<Screen xmlns="runtime-namespace:Game">
  <PanoramaWidget />
  <StackPanelWidget Direction="Horizontal">
    <CanvasWidget Style="{Widgets/TopBarContents}" />
    <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center">
      <CanvasWidget Margin="10, 0">
        <BevelledRectangleWidget Style="{Styles/Area}" />
        <ListPanelWidget Name="ModpacksList" Direction="Vertical" Margin="3, 3" ItemSize="96" SelectionColor="10, 70, 0, 90"/>
        <LabelWidget Name="ModpacksList.Placeholder" IsVisible="false" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </CanvasWidget>
      <StackPanelWidget Direction="Horizontal" Margin="10, 10">
        <BevelledButtonWidget Name="ToggleEnabledButton" IsEnabled="false" Size="160, 60"/>
        <BevelledButtonWidget Name="DownloadMissingButton" IsEnabled="false" Size="160, 60"/>
        <CanvasWidget Size="Infinity, 0" />
        <BevelledButtonWidget Name="ViewDetailButton" IsEnabled="false" Size="160, 60"/>
      </StackPanelWidget>
    </StackPanelWidget>
  </StackPanelWidget>
</Screen>
