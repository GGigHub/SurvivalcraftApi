<?xml version="1.0" encoding="utf-8"?>
<Screen xmlns="runtime-namespace:Game">
  <PanoramaWidget />
  <StackPanelWidget Direction="Horizontal">
    <CanvasWidget Style="{Widgets/TopBarContents}">
      <LabelWidget Name="TopBar.Label" Text="[ScbbsPlusMoreScreen:MoreScbbsPlus]" />
    </CanvasWidget>
    <StackPanelWidget Direction="Vertical" Margin="10, 0">
      <CanvasWidget Size="0, 20" />
      <CanvasWidget>
        <BevelledRectangleWidget Style="{Styles/Area}" />
        <ScrollPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3, 3">
          <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
              <LabelWidget Text="[ScbbsPlusMoreScreen:LoggedAccount]" HorizontalAlignment="Far" Margin="20, 0" VerticalAlignment="Center" Color="255, 255, 255" />
              <LabelWidget Name="ScbbsPlusMoreScreen.AccountInfo" VerticalAlignment="Center" Margin="20, 0" Text="[ScbbsPlusMoreScreen:NotLoggedIn]" FontScale="0.8" Color="255, 255, 255" MaxLines="1" Ellipsis="true" />
            </UniformSpacingPanelWidget>
            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
              <StackPanelWidget Direction="Vertical" VerticalAlignment="Center" HorizontalAlignment="Far" Margin="20, 0">
                <LabelWidget Text="[ScbbsPlusMoreScreen:CommunityAccount]" HorizontalAlignment="Far" FontScale="0.95" Color="255, 255, 255" />
                <LabelWidget Text="[ScbbsPlusMoreScreen:CommunityAccountDescription]" HorizontalAlignment="Far" FontScale="0.7" Color="128, 128, 128" WordWrap="true" />
              </StackPanelWidget>
              <BevelledButtonWidget Name="ScbbsPlusMoreScreen.AuthButton" Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center" Margin="20, 0" Text="[ScbbsPlusMoreScreen:LogIn]" />
            </UniformSpacingPanelWidget>
            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
              <StackPanelWidget Direction="Vertical" VerticalAlignment="Center" HorizontalAlignment="Far" Margin="20, 0">
                <LabelWidget Text="[ScbbsPlusMoreScreen:LinkImport]" HorizontalAlignment="Far" FontScale="0.95" Color="255, 255, 255" />
                <LabelWidget Text="[ScbbsPlusMoreScreen:LinkImportDescription]" HorizontalAlignment="Far" FontScale="0.7" Color="128, 128, 128" WordWrap="true" />
              </StackPanelWidget>
              <BevelledButtonWidget Name="ScbbsPlusMoreScreen.ImportButton" Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center" Margin="20, 0" Text="[ScbbsPlusMoreScreen:Import]" />
            </UniformSpacingPanelWidget>
            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
              <StackPanelWidget Direction="Vertical" VerticalAlignment="Center" HorizontalAlignment="Far" Margin="20, 0">
                <LabelWidget Text="[ScbbsPlusMoreScreen:DownloadQueue]" HorizontalAlignment="Far" FontScale="0.95" Color="255, 255, 255" />
                <LabelWidget Text="[ScbbsPlusMoreScreen:DownloadQueueDescription]" HorizontalAlignment="Far" FontScale="0.7" Color="128, 128, 128" WordWrap="true" />
              </StackPanelWidget>
              <BevelledButtonWidget Name="ScbbsPlusMoreScreen.DownloadQueueButton" Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center" Margin="20, 0" Text="[ScbbsPlusMoreScreen:View]" />
            </UniformSpacingPanelWidget>
            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
              <StackPanelWidget Direction="Vertical" VerticalAlignment="Center" HorizontalAlignment="Far" Margin="20, 0">
                <LabelWidget Text="[ScbbsPlusMoreScreen:ApiBaseUrl]" HorizontalAlignment="Far" FontScale="0.95" Color="255, 255, 255" />
                <LabelWidget Text="[ScbbsPlusMoreScreen:ApiBaseUrlDescription]" HorizontalAlignment="Far" FontScale="0.7" Color="128, 128, 128" WordWrap="true" />
              </StackPanelWidget>
              <CanvasWidget Size="310, 50" VerticalAlignment="Center" Margin="20, 0">
                <BevelledRectangleWidget Size="Infinity, 50" Style="{Styles/TextBoxArea}" />
                <TextBoxWidget Name="ScbbsPlusMoreScreen.ApiBaseUrlBox" Color="255, 255, 255" Margin="6, 0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
              </CanvasWidget>
              <BevelledButtonWidget Name="ScbbsPlusMoreScreen.ApiBaseUrlApplyButton" Style="{Styles/ButtonStyle_160x60}" VerticalAlignment="Center" Margin="20, 0" Text="[ScbbsPlusMoreScreen:Apply]" />
            </UniformSpacingPanelWidget>
            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
              <StackPanelWidget Direction="Vertical" VerticalAlignment="Center" HorizontalAlignment="Far" Margin="20, 0">
                <LabelWidget Text="[ScbbsPlusMoreScreen:DownloadSourceSelectionMode]" HorizontalAlignment="Far" FontScale="0.95" Color="255, 255, 255" />
                <LabelWidget Text="[ScbbsPlusMoreScreen:DownloadSourceSelectionModeDescription]" HorizontalAlignment="Far" FontScale="0.7" Color="128, 128, 128" WordWrap="true" />
              </StackPanelWidget>
              <BevelledButtonWidget Name="ScbbsPlusMoreScreen.DownloadSourceSelectionModeButton" Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center" Margin="20, 0" />
            </UniformSpacingPanelWidget>
            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
              <StackPanelWidget Direction="Vertical" VerticalAlignment="Center" HorizontalAlignment="Far" Margin="20, 0">
                <LabelWidget Text="[ScbbsPlusMoreScreen:DefaultDownloadSource]" HorizontalAlignment="Far" FontScale="0.95" Color="255, 255, 255" />
                <LabelWidget Text="[ScbbsPlusMoreScreen:DefaultDownloadSourceDescription]" HorizontalAlignment="Far" FontScale="0.7" Color="128, 128, 128" WordWrap="true" />
              </StackPanelWidget>
              <BevelledButtonWidget Name="ScbbsPlusMoreScreen.DefaultDownloadSourceButton" Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center" Margin="20, 0" />
            </UniformSpacingPanelWidget>
            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
              <StackPanelWidget Direction="Vertical" VerticalAlignment="Center" HorizontalAlignment="Far" Margin="20, 0">
                <LabelWidget Text="[ScbbsPlusMoreScreen:ApplyDownloadSourceToUpdates]" HorizontalAlignment="Far" FontScale="0.95" Color="255, 255, 255" />
                <LabelWidget Text="[ScbbsPlusMoreScreen:ApplyDownloadSourceToUpdatesDescription]" HorizontalAlignment="Far" FontScale="0.7" Color="128, 128, 128" WordWrap="true" />
              </StackPanelWidget>
              <BevelledButtonWidget Name="ScbbsPlusMoreScreen.ApplyDownloadSourceToUpdatesButton" Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center" Margin="20, 0" />
            </UniformSpacingPanelWidget>
            <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
              <StackPanelWidget Direction="Vertical" VerticalAlignment="Center" HorizontalAlignment="Far" Margin="20, 0">
                <LabelWidget Text="[ScbbsPlusMoreScreen:PlayedTimeReporting]" HorizontalAlignment="Far" FontScale="0.95" Color="255, 255, 255" />
                <LabelWidget Text="[ScbbsPlusMoreScreen:PlayedTimeReportingDescription]" HorizontalAlignment="Far" FontScale="0.7" Color="128, 128, 128" WordWrap="true" />
              </StackPanelWidget>
              <BevelledButtonWidget Name="ScbbsPlusMoreScreen.PlayedTimeReportingButton" Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center" Margin="20, 0" />
            </UniformSpacingPanelWidget>
          </StackPanelWidget>
        </ScrollPanelWidget>
      </CanvasWidget>
      <CanvasWidget Size="Infinity, 100">
        <LabelWidget Name="ScbbsPlusMoreScreen.Status" HorizontalAlignment="Center" VerticalAlignment="Center" TextAnchor="HorizontalCenter, VerticalCenter" Color="128, 128, 128" WordWrap="true" />
      </CanvasWidget>
    </StackPanelWidget>
  </StackPanelWidget>
</Screen>
