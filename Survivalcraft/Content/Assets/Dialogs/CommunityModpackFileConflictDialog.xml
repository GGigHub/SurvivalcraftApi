<CanvasWidget xmlns="runtime-namespace:Game" Size="700, 280" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
  <BevelledRectangleWidget Style="{Styles/DialogArea}" />
  <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="10, 10">
    <LabelWidget Text="[ModpackFileConflictDialog:DuplicateFileFound]" Color="255, 255, 255" HorizontalAlignment="Center" Margin="0, 5" />
    <CanvasWidget Size="0, Infinity" />
    <LabelWidget Name="ModpackFileConflictDialog.Message" Color="128, 128, 128" HorizontalAlignment="Center" WordWrap="true" Margin="10, 10" />
    <CanvasWidget Size="0, Infinity" />
    <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="20, 0">
      <BevelledButtonWidget Name="ModpackFileConflictDialog.OverwriteButton" Text="[ModpackFileConflictDialog:Overwrite]" Style="{Styles/ButtonStyle_115x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="ModpackFileConflictDialog.SkipButton" Text="[ModpackFileConflictDialog:Skip]" Style="{Styles/ButtonStyle_115x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="ModpackFileConflictDialog.SkipAllButton" Text="[ModpackFileConflictDialog:SkipAll]" Style="{Styles/ButtonStyle_115x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="ModpackFileConflictDialog.OverwriteAllButton" Text="[ModpackFileConflictDialog:OverwriteAll]" Style="{Styles/ButtonStyle_115x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="ModpackFileConflictDialog.CloseButton" Text="[ModpackFileConflictDialog:Close]" Style="{Styles/ButtonStyle_115x60}" />
    </StackPanelWidget>
  </StackPanelWidget>
</CanvasWidget>
