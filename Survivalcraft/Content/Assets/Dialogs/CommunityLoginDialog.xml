<CanvasWidget xmlns="runtime-namespace:Game" Size="600, 400" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
  <BevelledRectangleWidget Style="{Styles/DialogArea}" />
  <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="10, 10">
    <LabelWidget Text="[LoginDialog:LogInToCommunity]" Color="255, 255, 255" HorizontalAlignment="Center" Margin="0, 5" />
    <StackPanelWidget Direction="Horizontal" Margin="10, 10">
      <CanvasWidget Size="160, 50">
        <LabelWidget Text="[LoginDialog:AccountLabel]" VerticalAlignment="Center" HorizontalAlignment="Far" />
      </CanvasWidget>
      <CanvasWidget Size="10, 0" />
      <CanvasWidget>
        <BevelledRectangleWidget Size="Infinity, 50" Style="{Styles/TextBoxArea}" />
        <TextBoxWidget Name="LoginDialog.AccountBox" Color="255, 255, 255" Margin="6, 0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
      </CanvasWidget>
    </StackPanelWidget>
    <StackPanelWidget Direction="Horizontal" Margin="10, 10">
      <CanvasWidget Size="160, 50">
        <LabelWidget Text="[LoginDialog:PasswordLabel]" VerticalAlignment="Center" HorizontalAlignment="Far" />
      </CanvasWidget>
      <CanvasWidget Size="10, 0" />
      <CanvasWidget>
        <BevelledRectangleWidget Size="Infinity, 50" Style="{Styles/TextBoxArea}" />
        <TextBoxWidget Name="LoginDialog.PasswordBox" PasswordMode="true" Color="255, 255, 255" Margin="6, 0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
      </CanvasWidget>
    </StackPanelWidget>
    <LabelWidget Name="LoginDialog.ErrorLabel" Color="255, 80, 80" HorizontalAlignment="Center" WordWrap="true" Margin="10, 10" />
    <CanvasWidget Size="0, Infinity" />
    <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="20, 0">
      <BevelledButtonWidget Name="LoginDialog.LoginButton" Text="[LoginDialog:LogIn]" Style="{Styles/ButtonStyle_160x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="LoginDialog.RegisterButton" Text="[LoginDialog:Register]" Style="{Styles/ButtonStyle_160x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="LoginDialog.CancelButton" Style="{Styles/ButtonStyle_160x60}" />
    </StackPanelWidget>
  </StackPanelWidget>
</CanvasWidget>
