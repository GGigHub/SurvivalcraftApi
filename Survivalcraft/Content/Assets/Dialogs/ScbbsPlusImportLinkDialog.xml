<CanvasWidget xmlns="runtime-namespace:Game" Size="600, 320" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
  <BevelledRectangleWidget Style="{Styles/DialogArea}" />
  <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="10, 10">
    <LabelWidget Text="[ScbbsPlusImportLinkDialog:ImportResourceLink]" Color="255, 255, 255" HorizontalAlignment="Center" Margin="0, 5" />
    <LabelWidget Text="[ScbbsPlusImportLinkDialog:Message]" Color="128, 128, 128" HorizontalAlignment="Center" WordWrap="true" Margin="10, 5" />
    <CanvasWidget Size="0, Infinity" />
    <CanvasWidget Margin="10, 10">
      <BevelledRectangleWidget Size="Infinity, 50" Style="{Styles/TextBoxArea}" />
      <TextBoxWidget Name="ScbbsPlusImportLinkDialog.UrlBox" Color="255, 255, 255" Margin="6, 0" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaximumLength="2048" />
    </CanvasWidget>
    <CanvasWidget Size="0, Infinity" />
    <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="20, 0">
      <BevelledButtonWidget Name="ScbbsPlusImportLinkDialog.ConfirmButton" Text="[ScbbsPlusImportLinkDialog:Import]" Style="{Styles/ButtonStyle_160x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="ScbbsPlusImportLinkDialog.CancelButton" Style="{Styles/ButtonStyle_160x60}" />
    </StackPanelWidget>
  </StackPanelWidget>
</CanvasWidget>
