      <BevelledButtonWidget Name="ScbbsPlusImportOverwriteDialog.RenameButton" Text="[ScbbsPlusImportOverwriteDialog:Rename]" Style="{Styles/ButtonStyle_160x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="ScbbsPlusImportOverwriteDialog.CancelButton" Style="{Styles/ButtonStyle_160x60}" />
