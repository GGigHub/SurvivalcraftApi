    <LabelWidget Name="ScbbsPlusImportOverwriteDialog.Message" Color="128, 128, 128" HorizontalAlignment="Center" WordWrap="true" Margin="10, 10" />
    <CanvasWidget Size="0, Infinity" />
    <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="20, 0">
      <BevelledButtonWidget Name="ScbbsPlusImportOverwriteDialog.OverwriteButton" Text="[ScbbsPlusImportOverwriteDialog:Overwrite]" Style="{Styles/ButtonStyle_160x60}" />
