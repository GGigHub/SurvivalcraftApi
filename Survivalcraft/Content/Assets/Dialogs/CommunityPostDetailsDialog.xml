<CanvasWidget xmlns="runtime-namespace:Game" Size="920, 520" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
  <BevelledRectangleWidget Style="{Styles/DialogArea}" />
  <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="0, 10">
    <LabelWidget Name="PostDetailsDialog.Title" Text="[PostDetailsDialog:PostDetails]" Color="255, 255, 255" HorizontalAlignment="Center" />
    <ScrollPanelWidget Name="PostDetailsDialog.ScrollPanel" Direction="Vertical" Margin="5, 12">
      <StackPanelWidget Direction="Vertical" Margin="5, 0" HorizontalAlignment="Stretch">
        <LabelWidget Name="PostDetailsDialog.TranslateStatus" MarginBottom="8" Color="160, 210, 255" FontScale="0.7" WordWrap="true" IsVisible="false" />
        <StackPanelWidget Name="PostDetailsDialog.HeaderPanel" Direction="Vertical" HorizontalAlignment="Stretch" IsVisible="false" />
        <StackPanelWidget Name="PostDetailsDialog.ContentPanel" Direction="Vertical" HorizontalAlignment="Stretch" />
      </StackPanelWidget>
    </ScrollPanelWidget>
    <StackPanelWidget Name="PostDetailsDialog.ActionsRow" HorizontalAlignment="Center">
      <BevelledButtonWidget Name="PostDetailsDialog.ViewInBrowserButton" Text="[PostDetailsDialog:ViewInBrowser]" Style="{Styles/ButtonStyle_205x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="PostDetailsDialog.PrimaryButton" Text="[PostDetailsDialog:Download]" Style="{Styles/ButtonStyle_160x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="PostDetailsDialog.CloseButton" Text="[PostDetailsDialog:Close]" Style="{Styles/ButtonStyle_160x60}" />
    </StackPanelWidget>
  </StackPanelWidget>
</CanvasWidget>
