<CanvasWidget xmlns="runtime-namespace:Game" Size="660, 520" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
  <BevelledRectangleWidget Style="{Styles/DialogArea}" />
  <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="10, 10">
    <LabelWidget Text="[ScbbsPlusModInfoDialog:AboutModTitle]" Color="255, 230, 140" HorizontalAlignment="Center" />
    <CanvasWidget Size="0, 20" />
    <LabelWidget Name="ScbbsPlusModInfoDialog.NameLabel" Size="560, 40" Color="128, 128, 128" WordWrap="true" />
    <LabelWidget Name="ScbbsPlusModInfoDialog.VersionLabel" Size="560, 40" Color="128, 128, 128" WordWrap="true" />
    <LabelWidget Name="ScbbsPlusModInfoDialog.GameVersionLabel" Size="560, 40" Color="128, 128, 128" WordWrap="true" />
    <LabelWidget Name="ScbbsPlusModInfoDialog.ApiVersionLabel" Size="560, 40" Color="128, 128, 128" WordWrap="true" />
    <LabelWidget Name="ScbbsPlusModInfoDialog.AuthorLabel" Size="560, 44" Color="128, 128, 128" WordWrap="true" />
    <LabelWidget Name="ScbbsPlusModInfoDialog.DescriptionLabel" Size="560, 150" Color="128, 128, 128" WordWrap="true" />
    <CanvasWidget Size="0, Infinity" />
    <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Near">
      <LabelWidget Text="[ScbbsPlusModInfoDialog:ProjectAddress]" Color="128, 128, 128" />
      <LinkWidget Name="ScbbsPlusModInfoDialog.ProjectLink" Color="80, 170, 255" DropShadow="true" />
    </StackPanelWidget>
  </StackPanelWidget>
</CanvasWidget>
