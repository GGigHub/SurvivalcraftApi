<CanvasWidget xmlns="runtime-namespace:Game" Size="920, 560" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
  <BevelledRectangleWidget Style="{Styles/DialogArea}" />
  <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Near" Margin="0, 10">
    <LabelWidget Text="[DownloadQueueDialog:DownloadQueue]" Color="255, 255, 255" HorizontalAlignment="Center" Margin="0, 5" />
    <CanvasWidget Size="0, 10" />
    <RectangleWidget FillColor="0, 0, 0, 0" OutlineColor="128, 128, 128, 255" OutlineThickness="2" Size="Infinity, 2" />
    <ListPanelWidget Name="DownloadQueueDialog.TaskList" Direction="Vertical" Margin="10, 10" ItemSize="66" SelectionColor="10, 70, 0, 90" />
    <RectangleWidget FillColor="0, 0, 0, 0" OutlineColor="128, 128, 128, 255" OutlineThickness="2" Size="Infinity, 2" />
    <LabelWidget Name="DownloadQueueDialog.Selection" Text="[DownloadQueueDialog:SelectionHint]" Margin="10, 10" Color="128, 128, 128" HorizontalAlignment="Center" VerticalAlignment="Center" WordWrap="true" />
    <StackPanelWidget Direction="Horizontal" HorizontalAlignment="Center" Margin="20, 0">
      <BevelledButtonWidget Name="DownloadQueueDialog.PauseResumeButton" Text="[DownloadQueueDialog:PauseResume]" Style="{Styles/ButtonStyle_160x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="DownloadQueueDialog.CancelButton" Text="[DownloadQueueDialog:CancelTask]" Style="{Styles/ButtonStyle_160x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="DownloadQueueDialog.RetryButton" Text="[DownloadQueueDialog:Retry]" Style="{Styles/ButtonStyle_160x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="DownloadQueueDialog.ClearButton" Text="[DownloadQueueDialog:ClearDone]" Style="{Styles/ButtonStyle_160x60}" />
      <CanvasWidget Size="10, 0" />
      <BevelledButtonWidget Name="DownloadQueueDialog.CloseButton" Text="[DownloadQueueDialog:Close]" Style="{Styles/ButtonStyle_160x60}" />
    </StackPanelWidget>
  </StackPanelWidget>
</CanvasWidget>
