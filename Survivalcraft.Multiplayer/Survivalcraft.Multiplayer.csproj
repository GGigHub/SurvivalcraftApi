<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\Windows.props" />
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateModPackage Condition="'$(GenerateModPackage)' == '' and '$(BuildingInsideVisualStudio)' == 'true' and '$(DesignTimeBuild)' != 'true'">true</GenerateModPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Windows\Engine.Windows.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\EntitySystem.Windows\EntitySystem.Windows.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\Survivalcraft.Windows\Survivalcraft.Windows.csproj">
      <Private>false</Private>
      <AdditionalProperties>SkipNetworkModPackage=true;SkipCompatibilityModPackage=true;SkipContentZip=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <ModAsset Include="Assets\**\*" />
  </ItemGroup>

  <!-- Run explicitly with: dotnet build -c Release -p:GenerateModPackage=true -->
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(GenerateModPackage)' == 'true'">
    <PropertyGroup>
      <ModPackageDirectory Condition="'$(ModPackageDirectory)' == ''">$(OutputPath)scmod\</ModPackageDirectory>
      <ModPackageFile Condition="'$(ModPackageFile)' == ''">$(ModPackageDirectory)$(AssemblyName).scmod</ModPackageFile>
      <ModPackageStagingDirectory>$(IntermediateOutputPath)scmod\</ModPackageStagingDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(ModPackageStagingDirectory)" />
    <MakeDir Directories="$(ModPackageStagingDirectory);$(ModPackageDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModPackageStagingDirectory)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\modinfo.json" DestinationFolder="$(ModPackageStagingDirectory)" />
    <Copy SourceFiles="@(ModAsset)" DestinationFiles="@(ModAsset->'$(ModPackageStagingDirectory)%(Identity)')" />
    <ZipDirectory SourceDirectory="$(ModPackageStagingDirectory)" DestinationFile="$(ModPackageFile)" Overwrite="true" />
    <Message Importance="high" Text="Created mod package: $(ModPackageFile)" />
  </Target>

  <Target Name="CopyNetworkModToWindowsOutput" AfterTargets="PackageMod" Condition="'$(GenerateModPackage)' == 'true' and '$(BuildingInsideVisualStudio)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <NetworkModWindowsDestinationDirectory>$(MSBuildThisFileDirectory)..\Survivalcraft.Windows\bin\$(Configuration)\InternalMods\</NetworkModWindowsDestinationDirectory>
      <NetworkModWindowsDestinationFile>$(NetworkModWindowsDestinationDirectory)Survivalcraft.Multiplayer.scmod</NetworkModWindowsDestinationFile>
    </PropertyGroup>
    <MakeDir Directories="$(NetworkModWindowsDestinationDirectory)" />
    <Copy SourceFiles="$(ModPackageFile)" DestinationFiles="$(NetworkModWindowsDestinationFile)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied Network mod to $(NetworkModWindowsDestinationFile)" />
  </Target>

</Project>
