<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\Windows.props" />
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Survivalcraft.Windows\Survivalcraft.Windows.csproj">
      <AdditionalProperties>SkipNetworkModPackage=true;SkipContentZip=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\Survivalcraft.Multiplayer\Survivalcraft.Multiplayer.csproj" />
    <ProjectReference Include="..\Survivalcraft.Testing\Survivalcraft.Testing.csproj" />
    <ProjectReference Include="..\Survivalcraft.TestAutomation\Survivalcraft.TestAutomation.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="BuildAndCopyRelayServer" BeforeTargets="Build">
    <MSBuild Projects="..\Survivalcraft.RelayServer\Survivalcraft.RelayServer.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="..\Survivalcraft.CenterServer\Survivalcraft.CenterServer.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <RelayServerOutput Include="..\Survivalcraft.RelayServer\bin\$(Configuration)\net10.0\Survivalcraft.RelayServer.*" />
      <CenterServerOutput Include="..\Survivalcraft.CenterServer\bin\$(Configuration)\net10.0\Survivalcraft.CenterServer.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RelayServerOutput)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CenterServerOutput)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Compile Remove="Scripts\**\*.cs" />
    <Content Include="Scripts\**\*.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Survivalcraft.Testing\Coverage\*.json"
          Link="Coverage\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\build\NetworkMod.targets" />
</Project>
