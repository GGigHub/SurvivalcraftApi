<Project>
  <PropertyGroup>
    <NetworkModProject Condition="'$(NetworkModProject)' == ''">$(MSBuildThisFileDirectory)..\Survivalcraft.Multiplayer\Survivalcraft.Multiplayer.csproj</NetworkModProject>
    <NetworkModPackagePath Condition="'$(NetworkModPackagePath)' == ''">$(MSBuildThisFileDirectory)..\Survivalcraft.Multiplayer\bin\$(Configuration)\net10.0-windows\win-x64\scmod\Survivalcraft.Multiplayer.scmod</NetworkModPackagePath>
    <NetworkModPackageName Condition="'$(NetworkModPackageName)' == ''">Survivalcraft.Multiplayer.scmod</NetworkModPackageName>
    <NetworkModDestinationDirectory Condition="'$(NetworkModDestinationDirectory)' == '' and '$(OutputPath)' != ''">$(OutputPath)InternalMods\</NetworkModDestinationDirectory>
    <NetworkModDestinationFile Condition="'$(NetworkModDestinationFile)' == '' and '$(NetworkModDestinationDirectory)' != ''">$(NetworkModDestinationDirectory)$(NetworkModPackageName)</NetworkModDestinationFile>
  </PropertyGroup>

  <Target Name="PackageAndCopyNetworkMod" BeforeTargets="_ComputeAndroidAssetsPaths" AfterTargets="Build" Condition="'$(SkipNetworkModPackage)' != 'true'">
    <PropertyGroup>
      <NetworkModDestinationDirectory Condition="'$(NetworkModDestinationDirectory)' == ''">$(TargetDir)InternalMods\</NetworkModDestinationDirectory>
      <NetworkModDestinationFile Condition="'$(NetworkModDestinationFile)' == ''">$(NetworkModDestinationDirectory)$(NetworkModPackageName)</NetworkModDestinationFile>
    </PropertyGroup>
    <MSBuild Projects="$(NetworkModProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration);GenerateModPackage=true;TargetFramework=net10.0-windows;RuntimeIdentifier=win-x64" BuildInParallel="false" />
    <MakeDir Directories="$(NetworkModDestinationDirectory)" />
    <Copy SourceFiles="$(NetworkModPackagePath)" DestinationFiles="$(NetworkModDestinationFile)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied Network mod to $(NetworkModDestinationFile)" />
  </Target>
</Project>
